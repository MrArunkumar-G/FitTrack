<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// ═══════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════
const API = '';  // same origin
let token = localStorage.getItem('ft_token');
let user  = null;       // { id, username, startWeight, goalWeight, ... }
let logs  = [];         // all log entries from server
let photos = {};        // { 'week1': { front_photo, left_photo, right_photo, notes } }
let currentMood = 0;
let currentWater = 0;
let currentHabits = {};
let currentPhotoWeek = 1;
let weightChart = null;

// ═══════════════════════════════════════════════
//  UTILS
// ═══════════════════════════════════════════════
const $ = id => document.getElementById(id);
const fmt = v => v != null ? v : '—';
const fmtW = v => v != null ? parseFloat(v).toFixed(1) : '—';

function toast(msg, dur=2800){
  const t=$('toast');
  t.textContent=msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), dur);
}

function headers(){
  return { 'Content-Type':'application/json', 'Authorization':'Bearer '+token };
}

async function api(method, path, body){
  const opts = { method, headers: headers() };
  if(body) opts.body = JSON.stringify(body);
  const r = await fetch(API+path, opts);
  const data = await r.json();
  if(!r.ok) throw new Error(data.error || 'Request failed');
  return data;
}

// ═══════════════════════════════════════════════
//  AUTH
// ═══════════════════════════════════════════════
function switchTab(tab){
  ['login','register'].forEach(t=>{
    $(t+'-form').style.display = t===tab?'flex':'none';
    $(`auth-screen`).querySelectorAll('.auth-tab')[t==='login'?0:1]
      .classList.toggle('active', (t==='login'&&tab==='login')||(t==='register'&&tab==='register'));
  });
  if(tab==='login') $('l-err').textContent='';
  else $('r-err').textContent='';
}

async function doLogin(){
  const email=$('l-email').value.trim();
  const pass=$('l-pass').value;
  if(!email||!pass){$('l-err').textContent='Enter email and password';return;}
  try{
    const d = await api('POST','/api/auth/login',{email,password:pass});
    token = d.token;
    localStorage.setItem('ft_token', token);
    user = d.user;
    enterApp();
  }catch(e){$('l-err').textContent=e.message;}
}

async function doRegister(){
  const username=$('r-user').value.trim();
  const email=$('r-email').value.trim();
  const pass=$('r-pass').value;
  const sw=$('r-start').value||'105';
  const gw=$('r-goal').value||'82';
  if(!username||!email||!pass){$('r-err').textContent='Fill in all required fields';return;}
  try{
    const d = await api('POST','/api/auth/register',{username,email,password:pass,startWeight:sw,goalWeight:gw});
    token = d.token;
    localStorage.setItem('ft_token', token);
    user = d.user;
    enterApp();
  }catch(e){$('r-err').textContent=e.message;}
}

function doLogout(){
  localStorage.removeItem('ft_token');
  token=null; user=null; logs=[];
  $('app').style.display='none';
  $('auth-screen').style.display='flex';
}

// ═══════════════════════════════════════════════
//  APP INIT
// ═══════════════════════════════════════════════
async function init(){
  if(!token){ showAuth(); return; }
  try{
    user = await api('GET','/api/auth/me');
    await loadLogs();
    await loadPhotos();
    enterApp();
  }catch{
    localStorage.removeItem('ft_token');
    showAuth();
  }
}

function showAuth(){
  $('loading').classList.add('gone');
  $('auth-screen').style.display='flex';
}

async function enterApp(){
  $('loading').classList.add('gone');
  $('auth-screen').style.display='none';
  $('app').style.display='block';
  $('nav-username').textContent = user.username;

  // init today's date
  $('l-date').value = todayStr();
  initCups();
  initWeekSel();
  await loadLogs();
  await loadPhotos();
  updateDashboard();
  showPage('tracker');
}

async function loadLogs(){
  try{ logs = await api('GET','/api/logs'); }
  catch{ logs=[]; }
}

async function loadPhotos(){
  try{
    const rows = await api('GET','/api/photos');
    photos = {};
    rows.forEach(r=>{ photos['week'+r.week_number] = r; });
  }catch{ photos={}; }
}

function todayStr(){
  return new Date().toISOString().split('T')[0];
}

// ═══════════════════════════════════════════════
//  NAVIGATION
// ═══════════════════════════════════════════════
function showPage(id){
  ['tracker','plan'].forEach(p=>{
    $('page-'+p).classList.toggle('active', p===id);
    $('ntab-'+p)?.classList.toggle('active', p===id);
    $('mnav-'+p)?.classList.toggle('active', p===id);
  });
  if(id==='tracker') updateDashboard();
}

// ═══════════════════════════════════════════════
//  LOG FORM
// ═══════════════════════════════════════════════
function initCups(){
  const c=$('cups'); c.innerHTML='';
  for(let i=1;i<=12;i++){
    const d=document.createElement('div');
    d.className='cup'; d.dataset.i=i;
    d.onclick=()=>setCup(i);
    c.appendChild(d);
  }
}

function setCup(n){
  currentWater=n;
  document.querySelectorAll('.cup').forEach((c,i)=>c.classList.toggle('filled',i<n));
}

function setMood(v){
  currentMood=v;
  document.querySelectorAll('.mood-btn').forEach(b=>b.classList.toggle('sel',+b.dataset.v===v));
}

function toggleH(li, key){
  currentHabits[key] = !currentHabits[key];
  li.querySelector('.chk').classList.toggle('done', currentHabits[key]);
}

async function saveLog(){
  const d={
    log_date: $('l-date').value || todayStr(),
    weight:   $('l-weight').value || null,
    waist:    $('l-waist').value  || null,
    calories: $('l-cals').value   || null,
    protein:  $('l-prot').value   || null,
    steps:    $('l-steps').value  || null,
    sleep_hours: $('l-sleep').value || null,
    water:    currentWater || null,
    mood:     currentMood  || null,
    notes:    $('l-notes').value  || null,
    habits:   currentHabits,
  };
  try{
    await api('POST','/api/logs',d);
    toast('✅ Log saved!');
    await loadLogs();
    updateDashboard();
    // reset mood/water
    currentMood=0; currentWater=0; currentHabits={};
    document.querySelectorAll('.mood-btn').forEach(b=>b.classList.remove('sel'));
    document.querySelectorAll('.cup').forEach(c=>c.classList.remove('filled'));
    document.querySelectorAll('.chk').forEach(c=>c.classList.remove('done'));
  }catch(e){ toast('❌ '+e.message,3000); }
}

async function deleteLog(id){
  if(!confirm('Delete this log entry?')) return;
  try{
    await api('DELETE','/api/logs/'+id);
    toast('Deleted');
    await loadLogs();
    updateDashboard();
  }catch(e){ toast('❌ '+e.message,3000); }
}

// ═══════════════════════════════════════════════
//  DASHBOARD UPDATE
// ═══════════════════════════════════════════════
function updateDashboard(){
  const sw = user?.startWeight || 105;
  const gw = user?.goalWeight  || 82;

  // current weight = latest log with weight
  const latestW = logs.find(l=>l.weight!=null);
  const cur = latestW ? parseFloat(latestW.weight) : null;

  // stats
  $('s-weight').textContent = cur!=null ? fmtW(cur)+' kg' : '—';
  $('s-lost').textContent   = cur!=null ? `${(sw-cur).toFixed(1)} kg lost` : 'Log first weight';
  $('s-days').textContent   = logs.length;
  $('s-goal-lbl').textContent = `Target: ${gw} kg`;

  // streak
  let streak=0;
  const today=new Date();
  for(let i=0;i<200;i++){
    const d=new Date(today); d.setDate(d.getDate()-i);
    const ds=d.toISOString().split('T')[0];
    if(logs.find(l=>l.log_date&&l.log_date.startsWith(ds))) streak++;
    else break;
  }
  $('s-streak-num').textContent = streak;
  $('s-streak').textContent = streak>0?`🔥 ${streak} day streak!`:'Start your streak!';
  $('s-streak-sub').textContent = streak>6?'Amazing consistency!':streak>0?'Keep it up!':'Log today to start';

  // progress %
  let pct=0;
  if(cur!=null){
    pct = Math.max(0,Math.min(100,Math.round((sw-cur)/(sw-gw)*100)));
  }
  $('s-pct').textContent = pct+'%';
  $('pg-fill').style.width = pct+'%';
  $('pg-start').textContent = `Start: ${sw} kg`;
  $('pg-cur').textContent   = cur!=null?`Current: ${fmtW(cur)} kg`:`Current: — kg`;
  $('pg-goal').textContent  = `Goal: ${gw} kg`;

  // milestones (dynamic based on sw/gw)
  const ms = [95,90,87,82];
  ['ms1','ms2','ms3','ms4'].forEach((id,i)=>{
    const m=ms[i];
    $(id).textContent=m+' kg'+(i===3?' 🏆':'');
    $(id).classList.toggle('hit', cur!=null && cur<=m);
  });

  // today overview
  const ts = todayStr();
  const tl = logs.find(l=>l.log_date&&l.log_date.startsWith(ts));
  const moods=['','😩 Rough','😐 Okay','😊 Good','🔥 Beast!'];
  if(tl){
    $('today-overview').innerHTML=`<div class="overview-grid">
      <div class="ov-cell"><div class="ov-lbl">Calories</div><div class="ov-val" style="color:var(--amber)">${tl.calories?tl.calories+' kcal':'—'}</div></div>
      <div class="ov-cell"><div class="ov-lbl">Protein</div><div class="ov-val" style="color:var(--blue)">${tl.protein?tl.protein+'g':'—'}</div></div>
      <div class="ov-cell"><div class="ov-lbl">Steps</div><div class="ov-val" style="color:var(--green)">${tl.steps?tl.steps.toLocaleString():'—'}</div></div>
      <div class="ov-cell"><div class="ov-lbl">Mood</div><div class="ov-val">${moods[tl.mood]||'—'}</div></div>
    </div>`;
  } else {
    $('today-overview').innerHTML='<div style="font-size:13px;color:var(--text3);text-align:center;padding:16px 0">No entry for today yet. Log above ↑</div>';
  }

  drawChart();
  drawHabitRings();
  renderLogTable();
}

// ─── CHART ────────────────────────────────────
function drawChart(){
  const recent = [...logs].filter(l=>l.weight!=null).reverse().slice(-14);
  const labels = recent.map(l=>{
    const d=new Date(l.log_date);
    return (d.getMonth()+1)+'/'+(d.getDate());
  });
  const data   = recent.map(l=>parseFloat(l.weight));

  if(weightChart) weightChart.destroy();
  const ctx=$('weightChart').getContext('2d');
  weightChart = new Chart(ctx,{
    type:'line',
    data:{
      labels,
      datasets:[{
        label:'Weight (kg)',
        data,
        borderColor:'#16a34a',
        backgroundColor:'rgba(22,163,74,0.08)',
        fill:true,
        tension:0.4,
        pointBackgroundColor:'#16a34a',
        pointRadius:4,
        pointHoverRadius:6,
      }]
    },
    options:{
      responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false}},
      scales:{
        y:{
          ticks:{font:{size:11},color:'#94a3b8'},
          grid:{color:'rgba(0,0,0,0.05)'},
        },
        x:{
          ticks:{font:{size:11},color:'#94a3b8'},
          grid:{display:false},
        }
      }
    }
  });
}

// ─── HABIT RINGS ──────────────────────────────
function drawHabitRings(){
  const keys=['walk','water','protein','nojunk','nosugar','sleep','workout','nolate'];
  const names=['Steps','Water','Protein','No Junk','No Sugar','Sleep','Workout','No Late'];
  const today=new Date();
  const counts={};
  keys.forEach(k=>counts[k]=0);
  for(let i=0;i<7;i++){
    const d=new Date(today);d.setDate(d.getDate()-i);
    const ds=d.toISOString().split('T')[0];
    const lg=logs.find(l=>l.log_date&&l.log_date.startsWith(ds));
    if(lg&&lg.habits){
      const h=typeof lg.habits==='string'?JSON.parse(lg.habits):lg.habits;
      keys.forEach(k=>{if(h[k])counts[k]++;});
    }
  }
  $('habit-rings').innerHTML=`<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px">
    ${keys.map((k,i)=>{
      const p=Math.round(counts[k]/7*100);
      const color=p>=70?'var(--green)':p>=40?'var(--amber)':'var(--red)';
      return`<div style="text-align:center">
        <div style="width:52px;height:52px;border-radius:50%;background:conic-gradient(${color} ${p*3.6}deg,#e2e8f0 0deg);margin:0 auto;display:flex;align-items:center;justify-content:center">
          <div style="width:38px;height:38px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:${color}">${counts[k]}/7</div>
        </div>
        <div style="font-size:10px;color:var(--text3);margin-top:4px;font-weight:600">${names[i]}</div>
      </div>`;
    }).join('')}
  </div>`;
}

// ─── LOG TABLE ────────────────────────────────
function renderLogTable(){
  const moods=['','😩','😐','😊','🔥'];
  const tbody=$('hist-body');
  if(!logs.length){
    tbody.innerHTML='<tr><td colspan="9" style="text-align:center;color:var(--text3);padding:24px">No logs yet — start tracking!</td></tr>';
    return;
  }
  tbody.innerHTML = logs.map(l=>`
    <tr>
      <td>${l.log_date?l.log_date.split('T')[0]:''}</td>
      <td>${l.weight?parseFloat(l.weight).toFixed(1)+' kg':'—'}</td>
      <td>${l.calories||'—'}</td>
      <td>${l.protein?l.protein+'g':'—'}</td>
      <td>${l.steps?l.steps.toLocaleString():'—'}</td>
      <td>${l.sleep_hours||'—'}</td>
      <td>${l.water||'—'}</td>
      <td>${moods[l.mood]||'—'}</td>
      <td><button class="btn btn-sm btn-red" onclick="deleteLog(${l.id})">Delete</button></td>
    </tr>
  `).join('');
}

// ═══════════════════════════════════════════════
//  PHOTOS
// ═══════════════════════════════════════════════
function initWeekSel(){
  const s=$('week-selector'); s.innerHTML='';
  for(let w=1;w<=12;w++){
    const b=document.createElement('button');
    b.className='wbtn'+(w===1?' active':'');
    b.textContent='Week '+w;
    b.onclick=()=>selectWeek(w);
    s.appendChild(b);
  }
  loadPhotoWeek(1);
}

function selectWeek(w){
  currentPhotoWeek=w;
  document.querySelectorAll('.wbtn').forEach((b,i)=>b.classList.toggle('active',i+1===w));
  loadPhotoWeek(w);
}

async function loadPhotoWeek(w){
  $('photo-week-title').textContent=`Week ${w} Photos`;
  // check local cache
  const key='week'+w;
  if(!photos[key]){
    // try fetching from server
    try{
      const d=await api('GET','/api/photos/'+w);
      if(d) photos[key]=d;
    }catch{}
  }
  const data=photos[key]||{};
  ['front','left','right'].forEach(side=>{
    const slot=$('slot-'+side);
    const existing=slot.querySelector('img');
    if(existing) existing.remove();
    if(data[side+'_photo']){
      const img=document.createElement('img');
      img.src=data[side+'_photo'];
      slot.appendChild(img);
    }
    slot.querySelector('.ph-lbl').textContent=side.charAt(0).toUpperCase()+side.slice(1)+' View';
  });
  $('ph-notes').value=data.notes||'';
}

function triggerPh(side){ $('file-'+side).click(); }

function loadPh(side, event){
  const file=event.target.files[0];
  if(!file)return;
  const reader=new FileReader();
  reader.onload=async e=>{
    const b64=e.target.result;
    const key='week'+currentPhotoWeek;
    if(!photos[key]) photos[key]={};
    photos[key][side+'_photo']=b64;
    // update slot immediately
    const slot=$('slot-'+side);
    const existing=slot.querySelector('img');
    if(existing)existing.remove();
    const img=document.createElement('img');
    img.src=b64;
    slot.appendChild(img);
    // save to server
    try{
      await api('POST','/api/photos',{
        week_number:currentPhotoWeek,
        [side+'_photo']:b64,
        notes:$('ph-notes').value||null,
      });
      toast('📷 Photo saved for Week '+currentPhotoWeek);
    }catch(e){ toast('❌ '+e.message,3000); }
  };
  reader.readAsDataURL(file);
}

async function savePhNotes(){
  try{
    await api('POST','/api/photos',{
      week_number:currentPhotoWeek,
      notes:$('ph-notes').value||null,
    });
    toast('✅ Notes saved!');
  }catch(e){toast('❌ '+e.message,3000);}
}

// ═══════════════════════════════════════════════
//  BOOT
// ═══════════════════════════════════════════════
window.addEventListener('DOMContentLoaded', ()=>init());
</script>
</body>
</html>
