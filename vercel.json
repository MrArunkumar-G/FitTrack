<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FitTrack — 90-Day Transformation</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════
   LIGHT THEME TOKENS
   ═══════════════════════════════════════════════ */
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#f0fdf4;
  --bg2:#ffffff;
  --bg3:#f8fafc;
  --card:#ffffff;
  --green:#16a34a;
  --green2:#22c55e;
  --green3:#4ade80;
  --green-light:#dcfce7;
  --green-mid:#bbf7d0;
  --text:#1a2e1a;
  --text2:#4b6b4b;
  --text3:#94a3b8;
  --amber:#d97706;
  --red:#dc2626;
  --blue:#2563eb;
  --blue-light:#dbeafe;
  --border:#d1fae5;
  --border2:#e2e8f0;
  --shadow:0 1px 4px rgba(22,163,74,0.08),0 1px 2px rgba(0,0,0,0.04);
  --shadow-md:0 4px 16px rgba(22,163,74,0.1),0 2px 6px rgba(0,0,0,0.06);
  --radius:14px;
  --font:'Plus Jakarta Sans',sans-serif;
  --serif:'Lora',serif;
}
body{background:var(--bg);color:var(--text);font-family:var(--font);min-height:100vh;overflow-x:hidden}

/* ─── SCROLLBAR ─────────── */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-thumb{background:var(--green-mid);border-radius:99px}

/* ═══════════════════════════════════════════════
   AUTH SCREEN
   ═══════════════════════════════════════════════ */
#auth-screen{
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg,#f0fdf4 0%,#dcfce7 50%,#bbf7d0 100%);
  padding:24px;
}
.auth-card{
  background:#fff;border-radius:24px;padding:48px 40px;
  box-shadow:0 8px 40px rgba(22,163,74,0.12);
  width:100%;max-width:420px;
}
.auth-logo{font-size:32px;margin-bottom:6px;text-align:center}
.auth-title{font-family:var(--serif);font-size:26px;font-weight:600;text-align:center;color:var(--text);margin-bottom:4px}
.auth-sub{font-size:14px;color:var(--text2);text-align:center;margin-bottom:32px}
.auth-tabs{display:flex;background:var(--bg3);border-radius:10px;padding:4px;margin-bottom:28px}
.auth-tab{flex:1;padding:8px;border:none;background:none;font-family:var(--font);font-size:14px;font-weight:600;color:var(--text3);border-radius:7px;cursor:pointer;transition:all .2s}
.auth-tab.active{background:#fff;color:var(--green);box-shadow:var(--shadow)}
.auth-form{display:flex;flex-direction:column;gap:16px}
.auth-form-hidden{display:none}
.inp{width:100%;padding:12px 16px;border:1.5px solid var(--border2);border-radius:10px;font-family:var(--font);font-size:15px;color:var(--text);background:#fff;outline:none;transition:border-color .2s}
.inp:focus{border-color:var(--green)}
.inp::placeholder{color:var(--text3)}
.auth-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.inp-label{font-size:12px;font-weight:600;color:var(--text2);margin-bottom:4px;text-transform:uppercase;letter-spacing:.4px;display:block}
.inp-group{display:flex;flex-direction:column}
.auth-btn{padding:14px;background:var(--green);color:#fff;border:none;border-radius:10px;font-family:var(--font);font-size:15px;font-weight:700;cursor:pointer;transition:all .2s;letter-spacing:.3px}
.auth-btn:hover{background:#15803d;transform:translateY(-1px);box-shadow:0 4px 12px rgba(22,163,74,0.3)}
.auth-err{font-size:13px;color:var(--red);text-align:center;min-height:18px}

/* ═══════════════════════════════════════════════
   MAIN APP (hidden until logged in)
   ═══════════════════════════════════════════════ */
#app{display:none}

/* ─── TOP NAV ─────────── */
nav{
  position:sticky;top:0;z-index:100;
  background:rgba(255,255,255,0.95);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
  padding:0 24px;
}
.nav-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;height:60px;gap:4px}
.nav-logo{font-family:var(--serif);font-size:20px;font-weight:600;color:var(--green);margin-right:auto;display:flex;align-items:center;gap:8px}
.nav-logo span{font-size:22px}
.nav-tab{background:none;border:none;font-family:var(--font);font-size:14px;font-weight:600;color:var(--text2);padding:8px 18px;border-radius:8px;cursor:pointer;transition:all .2s}
.nav-tab:hover{background:var(--green-light);color:var(--green)}
.nav-tab.active{background:var(--green-light);color:var(--green)}
.nav-user{font-size:13px;color:var(--text2);margin-left:8px;display:flex;align-items:center;gap:8px}
.nav-user strong{color:var(--green)}
.logout-btn{background:none;border:1.5px solid var(--border2);border-radius:8px;padding:6px 14px;font-family:var(--font);font-size:13px;color:var(--text2);cursor:pointer;transition:all .2s}
.logout-btn:hover{border-color:var(--red);color:var(--red)}

/* ─── MOBILE NAV ─────────── */
.mobile-nav{
  display:none;position:fixed;bottom:0;left:0;right:0;z-index:200;
  background:rgba(255,255,255,0.97);backdrop-filter:blur(24px);
  border-top:1px solid var(--border);
  padding:0 4px env(safe-area-inset-bottom,0);
}
.mobile-nav-inner{display:flex;align-items:stretch;height:60px}
.m-btn{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:3px;border:none;background:none;color:var(--text3);
  font-family:var(--font);font-size:9px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;
  cursor:pointer;padding:4px;transition:color .2s;-webkit-tap-highlight-color:transparent;
}
.m-btn .icon{font-size:20px;line-height:1;transition:transform .2s}
.m-btn.active{color:var(--green)}
.m-btn.active .icon{transform:scale(1.15)}

/* ─── PAGES ─────────── */
.page{display:none;max-width:1100px;margin:0 auto;padding:28px 20px 80px}
.page.active{display:block}

/* ─── SECTION TITLE ─────────── */
.sec{font-family:var(--serif);font-size:20px;font-weight:600;color:var(--text);margin-bottom:16px;display:flex;align-items:center;gap:8px}
.sec-small{font-size:16px;margin-bottom:12px}

/* ─── GRID ─────────── */
.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
.g3{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.g4{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}

/* ─── CARD ─────────── */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow)}
.card-t{font-family:var(--font);font-size:15px;font-weight:700;color:var(--text);margin-bottom:14px;display:flex;align-items:center;gap:6px}

/* ─── STAT CARD ─────────── */
.stat{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px 16px;text-align:center;box-shadow:var(--shadow)}
.stat .val{font-family:var(--serif);font-size:30px;font-weight:600;color:var(--green);line-height:1}
.stat .lbl{font-size:11px;font-weight:700;color:var(--text3);margin-top:4px;text-transform:uppercase;letter-spacing:.5px}
.stat .sub{font-size:12px;color:var(--text2);margin-top:5px}

/* ─── PROGRESS BAR ─────────── */
.prog-wrap{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px 22px;margin-bottom:20px;box-shadow:var(--shadow)}
.prog-labels{display:flex;justify-content:space-between;font-size:12px;color:var(--text2);margin-bottom:8px;font-weight:500}
.prog-track{background:var(--bg3);height:12px;border-radius:99px;overflow:hidden;border:1px solid var(--border2)}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--green),var(--green2));border-radius:99px;transition:width .6s cubic-bezier(.4,0,.2,1)}
.milestones{display:flex;justify-content:space-between;margin-top:6px}
.ms{font-size:11px;color:var(--text3);font-weight:500}
.ms.hit{color:var(--green);font-weight:700}

/* ─── FORM ─────────── */
.fg{margin-bottom:14px}
.fg label{font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.4px;display:block;margin-bottom:5px}
.fg input,.fg select,.fg textarea{
  width:100%;background:#fff;border:1.5px solid var(--border2);border-radius:8px;
  padding:10px 14px;color:var(--text);font-family:var(--font);font-size:14px;
  outline:none;transition:border-color .2s;
}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--green)}
.fg textarea{resize:vertical;min-height:70px}
.fg input[type=number]{-moz-appearance:textfield}
.fg input[type=number]::-webkit-inner-spin-button{display:none}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:12px}

/* ─── BUTTONS ─────────── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:10px 20px;background:var(--green);color:#fff;border:none;border-radius:9px;font-family:var(--font);font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;min-height:40px}
.btn:hover{background:#15803d;box-shadow:0 3px 10px rgba(22,163,74,0.25)}
.btn-full{width:100%}
.btn-sm{padding:7px 14px;font-size:13px}
.btn-outline{background:none;color:var(--green);border:1.5px solid var(--green-mid)}
.btn-outline:hover{background:var(--green-light)}
.btn-red{background:rgba(220,38,38,.08);color:var(--red);border:1px solid rgba(220,38,38,.18)}
.btn-red:hover{background:rgba(220,38,38,.15)}

/* ─── DIVIDER ─────────── */
hr.div{border:none;border-top:1px solid var(--border);margin:24px 0}

/* ─── TOAST ─────────── */
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--green);color:#fff;padding:10px 22px;border-radius:10px;font-size:13px;font-weight:600;z-index:999;opacity:0;transition:opacity .3s,transform .3s;pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ─── MOOD BUTTONS ─────────── */
.mood-row{display:flex;gap:8px;flex-wrap:wrap}
.mood-btn{background:var(--bg3);border:1.5px solid var(--border2);border-radius:10px;padding:8px 12px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;transition:all .2s;min-width:60px}
.mood-btn .emoji{font-size:22px;line-height:1}
.mood-btn span{font-size:10px;color:var(--text3);font-weight:600}
.mood-btn.sel{border-color:var(--green);background:var(--green-light)}

/* ─── WATER CUPS ─────────── */
.cups{display:flex;gap:6px;flex-wrap:wrap}
.cup{width:36px;height:46px;background:var(--bg3);border:1.5px solid var(--border2);border-radius:4px 4px 6px 6px;cursor:pointer;transition:all .2s;position:relative;overflow:hidden}
.cup.filled{border-color:#3b82f6}
.cup.filled::after{content:'';position:absolute;inset:0;background:rgba(59,130,246,.22)}

/* ─── HABITS CHECKLIST ─────────── */
.checklist{list-style:none}
.checklist li{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--border);font-size:14px;color:var(--text2);cursor:pointer;user-select:none;transition:color .2s}
.checklist li:last-child{border-bottom:none}
.checklist li:hover{color:var(--text)}
.chk{width:22px;height:22px;border:1.5px solid var(--border2);border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .2s}
.chk.done{background:var(--green);border-color:var(--green)}
.chk.done::after{content:'✓';color:#fff;font-size:12px;font-weight:700}

/* ─── LOG TABLE ─────────── */
.log-table{width:100%;border-collapse:collapse;font-size:13px}
.log-table th{text-align:left;padding:8px 12px;color:var(--text3);font-size:11px;text-transform:uppercase;letter-spacing:.4px;border-bottom:1.5px solid var(--border)}
.log-table td{padding:10px 12px;border-bottom:1px solid var(--border);color:var(--text2)}
.log-table tr:last-child td{border-bottom:none}
.log-table tbody tr:hover td{background:var(--bg3)}

/* ─── PHOTO GRID ─────────── */
.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.photo-slot{aspect-ratio:2/3;background:var(--bg3);border:2px dashed var(--border2);border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:all .2s;overflow:hidden;position:relative}
.photo-slot:hover{border-color:var(--green);background:var(--green-light)}
.photo-slot img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
.photo-slot input{display:none}
.ph-lbl{font-size:11px;font-weight:600;color:var(--text3);text-align:center}
.ph-icon{font-size:28px}
.week-sel{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.wbtn{background:var(--bg3);border:1.5px solid var(--border2);border-radius:8px;padding:5px 12px;font-size:12px;font-weight:600;color:var(--text2);cursor:pointer;transition:all .2s;white-space:nowrap}
.wbtn.active{background:var(--green-light);color:var(--green);border-color:var(--green-mid)}

/* ─── CHART ─────────── */
.chart-wrap{position:relative;height:200px;margin-top:8px}
canvas{width:100%!important}

/* ─── MEAL BLOCK ─────────── */
.meal-blk{border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-bottom:8px;background:#fff}
.meal-time{font-size:11px;font-weight:700;color:var(--green);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
.meal-name{font-size:14px;font-weight:600;color:var(--text)}
.meal-cal{font-size:12px;color:var(--text2);margin-top:3px}

/* ─── BADGE ─────────── */
.badge{display:inline-block;padding:3px 10px;border-radius:99px;font-size:11px;font-weight:600}
.badge-green{background:var(--green-light);color:var(--green)}
.badge-amber{background:#fef3c7;color:var(--amber)}
.badge-red{background:#fee2e2;color:var(--red)}
.badge-blue{background:var(--blue-light);color:var(--blue)}

/* ─── TODAY OVERVIEW ─────────── */
.overview-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ov-cell{background:var(--bg3);border-radius:8px;padding:10px 12px}
.ov-cell .ov-lbl{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.4px}
.ov-cell .ov-val{font-size:18px;font-weight:700;color:var(--text);margin-top:2px}

/* ═══════════════════════════════════════════════
   RESPONSIVE
   ═══════════════════════════════════════════════ */
@media(max-width:768px){
  nav{display:none}
  .mobile-nav{display:flex;flex-direction:column}
  .page{padding:16px 14px 80px}
  .frow{grid-template-columns:1fr}
  .g2{grid-template-columns:1fr}
  .g3{grid-template-columns:1fr 1fr}
  .photo-grid{gap:8px}
  .stat .val{font-size:24px}
  .auth-card{padding:32px 24px}
  .auth-row{grid-template-columns:1fr}
  .log-table th,.log-table td{padding:8px 8px;font-size:12px}
}
@media(max-width:480px){
  .g3{grid-template-columns:1fr 1fr}
  .g4{grid-template-columns:1fr 1fr}
  .meal-blk{padding:10px 12px}
}

/* ─── LOADING SCREEN ─────────── */
#loading{position:fixed;inset:0;background:#f0fdf4;display:flex;align-items:center;justify-content:center;z-index:999;transition:opacity .4s}
#loading.gone{opacity:0;pointer-events:none}
.spin{width:36px;height:36px;border:3px solid var(--green-mid);border-top-color:var(--green);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ─── EXERCISE TABLE ─────────── */
.ex-table{width:100%;border-collapse:collapse;font-size:13px}
.ex-table th{text-align:left;padding:8px 10px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--text3);border-bottom:1.5px solid var(--border)}
.ex-table td{padding:9px 10px;border-bottom:1px solid var(--border);color:var(--text2)}
.ex-table tr:last-child td{border-bottom:none}
.ex-table tbody tr:hover td{background:var(--bg3)}

/* weekly schedule */
.schedule-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;text-align:center}
.day-cell{border-radius:10px;padding:10px 4px}
.day-cell .day-name{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px}
.day-cell .day-desc{font-size:10px;color:var(--text2);line-height:1.5}
.day-green{background:var(--green-light)}
.day-green .day-name{color:var(--green)}
.day-blue{background:var(--blue-light)}
.day-blue .day-name{color:var(--blue)}
.day-rest{background:var(--bg3)}
.day-rest .day-name{color:var(--text3)}

/* tip card */
.tip{background:var(--green-light);border:1px solid var(--green-mid);border-radius:12px;padding:14px 16px;margin-bottom:10px}
.tip-t{font-size:14px;font-weight:700;color:var(--green);margin-bottom:4px}
.tip-b{font-size:13px;color:var(--text2);line-height:1.6}

/* ─── ANIMATION ─────────── */
.page.active .card,.page.active .stat,.page.active .prog-wrap{
  animation:fadeUp .35s ease both;
}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.page.active .card:nth-child(2){animation-delay:.05s}
.page.active .card:nth-child(3){animation-delay:.1s}
.page.active .card:nth-child(4){animation-delay:.15s}
</style>
</head>
<body>

<!-- LOADING -->
<div id="loading"><div class="spin"></div></div>

<!-- ═══════════════ AUTH SCREEN ═══════════════ -->
<div id="auth-screen" style="display:none">
  <div class="auth-card">
    <div class="auth-logo">🌿</div>
    <div class="auth-title">FitTrack</div>
    <div class="auth-sub">Your 90-Day Transformation Journal</div>

    <div class="auth-tabs">
      <button class="auth-tab active" onclick="switchTab('login')">Sign In</button>
      <button class="auth-tab" onclick="switchTab('register')">Register</button>
    </div>

    <!-- LOGIN -->
    <div class="auth-form" id="login-form">
      <div class="inp-group">
        <label class="inp-label">Email</label>
        <input class="inp" id="l-email" type="email" placeholder="you@email.com" autocomplete="email">
      </div>
      <div class="inp-group">
        <label class="inp-label">Password</label>
        <input class="inp" id="l-pass" type="password" placeholder="••••••••" autocomplete="current-password">
      </div>
      <p class="auth-err" id="l-err"></p>
      <button class="auth-btn" onclick="doLogin()">Sign In →</button>
    </div>

    <!-- REGISTER -->
    <div class="auth-form auth-form-hidden" id="reg-form">
      <div class="auth-row">
        <div class="inp-group">
          <label class="inp-label">Username</label>
          <input class="inp" id="r-user" type="text" placeholder="yourname">
        </div>
        <div class="inp-group">
          <label class="inp-label">Email</label>
          <input class="inp" id="r-email" type="email" placeholder="you@email.com">
        </div>
      </div>
      <div class="inp-group">
        <label class="inp-label">Password (min 6 chars)</label>
        <input class="inp" id="r-pass" type="password" placeholder="••••••••">
      </div>
      <div class="auth-row">
        <div class="inp-group">
          <label class="inp-label">Start Weight (kg)</label>
          <input class="inp" id="r-start" type="number" placeholder="105" step="0.1">
        </div>
        <div class="inp-group">
          <label class="inp-label">Goal Weight (kg)</label>
          <input class="inp" id="r-goal" type="number" placeholder="82" step="0.1">
        </div>
      </div>
      <p class="auth-err" id="r-err"></p>
      <button class="auth-btn" onclick="doRegister()">Create Account →</button>
    </div>
  </div>
</div>

<!-- ═══════════════ MAIN APP ═══════════════ -->
<div id="app">

  <!-- DESKTOP NAV -->
  <nav>
    <div class="nav-inner">
      <div class="nav-logo"><span>🌿</span> FitTrack</div>
      <button class="nav-tab active" onclick="showPage('tracker')" id="ntab-tracker">📊 Tracker</button>
      <button class="nav-tab" onclick="showPage('plan')" id="ntab-plan">📋 Plan</button>
      <div class="nav-user">
        Hi, <strong id="nav-username">User</strong>
        <button class="logout-btn" onclick="doLogout()">Logout</button>
      </div>
    </div>
  </nav>

  <!-- MOBILE NAV -->
  <div class="mobile-nav">
    <div class="mobile-nav-inner">
      <button class="m-btn active" onclick="showPage('tracker')" id="mnav-tracker">
        <span class="icon">📊</span>Tracker
      </button>
      <button class="m-btn" onclick="showPage('plan')" id="mnav-plan">
        <span class="icon">📋</span>Plan
      </button>
      <button class="m-btn" onclick="doLogout()">
        <span class="icon">🚪</span>Logout
      </button>
    </div>
  </div>

  <!-- ════════════════ PAGE 1: TRACKER ════════════════ -->
  <div class="page active" id="page-tracker">

    <!-- STATS ROW -->
    <div class="g4" style="margin-bottom:16px">
      <div class="stat">
